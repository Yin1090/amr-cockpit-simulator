      "control": 150,
      "health": 250,
      "telemetry": 400,
      "map": 500,
      "map_full": 1000
    },
    "zone_wire_mapping": {
      "zF": "front",
      "zB": "back",
      "zL": "left",
      "zR": "right",
      "zFL": "front_left",
      "zFR": "front_right",
      "zBL": "back_left",
      "zBR": "back_right"
    },
    "fsm_contract": {
      "duplicate_arm": "HTTP 422 FAILED, PREFLIGHT_NOT_READY",
      "stop": "HTTP 200 SENT, STOP_CONFIRMED (armed=false, latched=true)"
    }
