  "onboard_compute": {
    "sbc": "Raspberry Pi 4",
    "ros_distro": "ROS 2 Jazzy",
    "nodes": [
      "rplidar_ros2",
      "slam_toolbox",
      "tf2 static_transform_publisher"
    ],
    "ports": {
      "rest_api": 8080,
      "mjpeg_camera": 8081,
      "mjpeg_resolution": "640x480",
      "auth_proxy": 8090
