{
  "platform": "Differential-Drive 2-Wheel AMR Cockpit Reference",
  "kinematics": {
    "wheel_radius_m": 0.0366,
    "physical_track_width_m": 0.1875,
    "physical_half_wheelbase_m": 0.09375,
    "simulator_half_wheelbase_m": 0.096,
    "mps_per_rpm": 0.00383274,
    "rpm_min": 40,
    "rpm_max": 135,
    "rpm_step": 10,
    "angular_gain": 0.60,
    "max_omega_rad_s": 1.80
